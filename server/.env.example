# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development
# Not 5000: macOS AirPlay Receiver listens there.
PORT=5050

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true for readable local logs; keep false in production (JSON lines).
LOG_PRETTY=false

# Swagger UI at /api/v1/docs and the spec at /api/v1/docs/openapi.json.
API_DOCS_ENABLED=true

# MongoDB Atlas connection string, database name included:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/swimato?retryWrites=true&w=majority
MONGO_URI=

# Comma-separated browser origins allowed to call the API. Drives both
# CORS and the CSRF origin check on POST/PATCH/PUT/DELETE. Same-origin
# requests are always allowed, which covers the CRA dev proxy (it
# rewrites Origin to this API). List the web app's origin in production.
CLIENT_ORIGIN=http://localhost:3000

# Two different keys, one per token type. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_ROUNDS=12

# Optional: create an admin account at boot (signup only makes users).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Local dev is same-origin over http, so Lax and non-Secure are correct.
# In production: COOKIE_SECURE=true, and COOKIE_DOMAIN=.yourdomain.com
# only if the frontend and API sit on different subdomains.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

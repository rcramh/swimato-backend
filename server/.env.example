# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, database name included:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/swimato?retryWrites=true&w=majority
MONGO_URI=

# Comma-separated browser origins allowed to send credentialed requests.
# Unused while the CRA dev proxy makes calls same-origin.
CLIENT_ORIGIN=http://localhost:3000

# Signs the access JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Refresh tokens are opaque random strings checked against the database,
# so they need no signing key of their own.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Local dev is same-origin over http, so Lax and non-Secure are correct.
# In production: COOKIE_SECURE=true, and COOKIE_DOMAIN=.yourdomain.com
# only if the frontend and API sit on different subdomains.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
